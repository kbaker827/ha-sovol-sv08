{
  "config": {
    "step": {
      "user": {
        "title": "Connect to Sovol SV08",
        "description": "Enter the address of your Sovol SV08 (the one you open Mainsail with). Leave the API key blank unless you turned on Moonraker authentication.",
        "data": {
          "host": "IP address or hostname",
          "port": "Port",
          "api_key": "API key (optional)"
        },
        "data_description": {
          "host": "For example 192.168.1.50. Shown on the printer's touchscreen under network settings.",
          "port": "80 on a stock SV08 (Moonraker behind nginx). Use 7125 to talk to Moonraker directly.",
          "api_key": "Only needed if you set up Moonraker authentication."
        }
      },
      "reconfigure": {
        "title": "Reconfigure Sovol SV08",
        "description": "Update the connection settings. Entities and their history are kept.",
        "data": {
          "host": "IP address or hostname",
          "port": "Port",
          "api_key": "API key (optional)"
        }
      },
      "reauth_confirm": {
        "title": "New API key needed",
        "description": "Moonraker on your Sovol SV08 rejected the API key. Enter a valid one (Mainsail → Settings → Authentication).",
        "data": {
          "api_key": "API key"
        }
      }
    },
    "error": {
      "cannot_connect": "Could not reach Moonraker. Check the address, that the printer is on, and that Mainsail opens in a browser at the same address.",
      "invalid_auth": "Moonraker rejected the API key. Check it, or leave it blank if Home Assistant is a trusted client."
    },
    "abort": {
      "already_configured": "This printer is already set up.",
      "reconfigure_successful": "The printer's connection settings were updated.",
      "reauth_successful": "The API key was updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Sovol SV08 options",
        "data": {
          "scan_interval": "Fallback poll interval (seconds)",
          "temperature_unit": "Temperature unit"
        },
        "data_description": {
          "scan_interval": "How often to poll over HTTP while the WebSocket is disconnected (10-300 seconds).",
          "temperature_unit": "Unit for all printer temperatures. 3D printing normally uses °C, even if the rest of Home Assistant uses °F."
        }
      }
    }
  },
